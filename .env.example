# ============================================================
# APPLICATION CORE
# ============================================================

APP_ENV=development
DEBUG=true
LOG_LEVEL=info
PORT=3000

# ============================================================
# TELEGRAM BOT CONFIGURATION
# ============================================================

BOT_TOKEN=your-telegram-bot-token-from-botfather
ADMIN_ID=123456789
BOT_NAME=DateWithStranger
BOT_USER=@testdate27_bot
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook/telegram
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-token

# ============================================================
# SUPABASE POSTGRESQL (PRIMARY DATASTORE)
# ============================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres
SUPABASE_PROJECT_REF=your-project-ref

# ============================================================
# LEGACY MONGODB (MIGRATION SOURCE ONLY - READ-ONLY)
# ============================================================

MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=datestranger

# ============================================================
# REDIS (MATCHMAKING QUEUE / SESSIONS / RATE LIMITING)
# ============================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# ============================================================
# QUEUES & WORKERS
# ============================================================

QUEUE_REDIS_URL=redis://localhost:6379/0

# ============================================================
# CLOUDFLARE R2 OBJECT STORAGE (MEDIA STORAGE)
# ============================================================

CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=datestranger-media
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.datestranger.com

# ============================================================
# COUCHBASE CAPELLA (MEDIA STORAGE - REPLACES R2 PLAN)
# ============================================================

COUCHBASE_ENDPOINT=couchbases://cb.xxxxxxxx.cloud.couchbase.com
COUCHBASE_USERNAME=your-capella-db-username
COUCHBASE_PASSWORD=your-capella-db-password
COUCHBASE_BUCKET=lmedia
COUCHBASE_SCOPE=_default
COUCHBASE_COLLECTION=media

# ============================================================
# DISCORD LOGGING WEBHOOKS
# ============================================================

STATUS_WEBHOOK=https://discord.com/api/webhooks/your-status-webhook
ALERTS_WEBHOOK=https://discord.com/api/webhooks/your-alerts-webhook
CHAT_LOG_WEBHOOK=https://discord.com/api/webhooks/your-chat-log-webhook
MEDIA_LOG_WEBHOOK=https://discord.com/api/webhooks/your-media-log-webhook
VOICE_LOG_WEBHOOK=https://discord.com/api/webhooks/your-voice-log-webhook
GIRL_WEBHOOK=https://discord.com/api/webhooks/your-female-user-webhook
BOY_WEBHOOK=https://discord.com/api/webhooks/your-male-user-webhook
OTHER_WEBHOOK=https://discord.com/api/webhooks/your-other-user-webhook
GIRL_MEDIA_WEBHOOK=https://discord.com/api/webhooks/your-female-media-webhook
BOY_MEDIA_WEBHOOK=https://discord.com/api/webhooks/your-male-media-webhook
OTHER_MEDIA_WEBHOOK=https://discord.com/api/webhooks/your-other-media-webhook

# ============================================================
# MEDIA PROCESSING
# ============================================================

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ============================================================
# SECURITY & AUTHENTICATION
# ============================================================

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_FOR_JWT
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_FOR_SESSIONS

# ============================================================
# MONITORING & OBSERVABILITY
# ============================================================

SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================================
# PAYMENT & MONETIZATION
# ============================================================

PAYMENT_PROVIDER=telegram_payments
PAYMENT_API_KEY=your-payment-provider-api-key
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret

# ============================================================
# EMAIL (NOTIFICATION / ADMIN ALERTS)
# ============================================================

RESEND_API_KEY=your-resend-api-key

# ============================================================
# APPLICATION URLS
# ============================================================

APP_URL=https://datestranger.com
API_URL=https://api.datestranger.com
WEBHOOK_URL=https://api.datestranger.com/webhook/telegram

# ============================================================
# SYNTHETIC / DEMO USER CONVERSATION ENGINE
# ============================================================

# Mode options: OFF, DEMO, DEVELOPMENT, LOAD_TEST
SYNTHETIC_MODE=DEMO
SECRET_BOT_ENABLED=true
SECRET_BOT_ID=999999999

