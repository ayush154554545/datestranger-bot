# Telegram Configuration
BOT_TOKEN=your-telegram-bot-token
ADMIN_ID=your-admin-telegram-id

# Supabase PostgreSQL Configuration (Server-Only Service Role Key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Legacy MongoDB Configuration (Migration Source Only)
MONGO_URL=your-legacy-mongodb-url
DB_NAME=datestranger

# Optional Discord Webhook Logging
STATUS_WEBHOOK=your-discord-webhook
ALERTS_WEBHOOK=your-discord-webhook
CHAT_LOG_WEBHOOK=your-discord-webhook
MEDIA_LOG_WEBHOOK=your-discord-webhook
VOICE_LOG_WEBHOOK=your-discord-webhook
GIRL_WEBHOOK=your-discord-webhook
BOY_WEBHOOK=your-discord-webhook
OTHER_WEBHOOK=your-discord-webhook
GIRL_MEDIA_WEBHOOK=your-discord-webhook
BOY_MEDIA_WEBHOOK=your-discord-webhook
OTHER_MEDIA_WEBHOOK=your-discord-webhook

# Synthetic / Demo Conversation Engine
# Modes: OFF, DEMO, DEVELOPMENT, LOAD_TEST
SYNTHETIC_MODE=DEMO
SECRET_BOT_ENABLED=true
SECRET_BOT_ID=999999999

